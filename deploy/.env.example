# Copy thành .env.local (máy dev) hoặc deploy/.env (server). Không commit file thật.
SPRING_PROFILES_ACTIVE=api
DB_URL=jdbc:postgresql://localhost:5432/vingo
DB_USER=vingo
DB_PASSWORD=vingo
REDIS_URL=redis://localhost:6379

# Chuỗi ngẫu nhiên >= 32 byte: openssl rand -base64 48
# Máy dev: giữ nguyên dòng comment, profile local tự dùng secret mặc định.
# Server: bắt buộc bỏ comment và điền, nếu không app không khởi động.
# Không để "JWT_SECRET=" rỗng: giá trị rỗng đè mất mặc định và app báo "must not be blank".
# JWT_SECRET=

GOOGLE_CLIENT_ID=

# VNPay sandbox (lấy từ email đăng ký sandbox)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=http://localhost:5173/payment/result

MAIL_API_KEY=
MAIL_FROM=no-reply@vingo.local

SENTRY_DSN=

# Chỉ dùng trên server
DOMAIN=
IMAGE_TAG=latest
